{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar CRUD PHP",
      "type": "node-terminal",
      "request": "launch",
      "command": "php -S localhost:8000 -t \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
